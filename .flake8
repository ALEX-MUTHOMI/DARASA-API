[flake8]
max-line-length = 88
extend-ignore =
    E203,
    W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .mutmut-cache,
    .venv,
    venv,
    env,
    build,
    dist,
    htmlcov,
    */migrations/*
per-file-ignores =
    */__init__.py:F401
count = true
show-source = true
statistics = true
