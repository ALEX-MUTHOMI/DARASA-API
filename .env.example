COMPOSE_PROJECT_NAME=darasa-core
HOST_UID=1000
HOST_GID=1000

DJANGO_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
TOXIPROXY_API_HOST_PORT=8474
TOXIPROXY_POSTGRES_HOST_PORT=5433
TOXIPROXY_REDIS_HOST_PORT=6380

DJANGO_SETTINGS_MODULE=darasa_project.settings
SECRET_KEY=change-me-use-a-long-random-value
DARASA_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,django
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=darasa_core
POSTGRES_USER=darasa
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://darasa:change-me-postgres-password@postgres:5432/darasa_core

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_TASK_ALWAYS_EAGER=0
CELERY_LOG_LEVEL=info

JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-bytes
# Local/dev/CI sample only. Rotate with a generated Fernet key in production.
FERNET_ENCRYPTION_KEY=ZGFyYXNhLWNvcmUtbG9jYWwtZGV2LWtleS0wMDAxMjM=

TENANT_PUBLIC_SCHEMA_NAME=public
PG_EXTRA_SEARCH_PATHS=

TOXIPROXY_HOST=toxiproxy
TOXIPROXY_API_PORT=8474
TOXIPROXY_API_URL=http://toxiproxy:8474
TOXIPROXY_POSTGRES_PROXY_NAME=postgres
TOXIPROXY_POSTGRES_HOST=toxiproxy
TOXIPROXY_POSTGRES_PORT=15432
TOXIPROXY_POSTGRES_UPSTREAM=postgres:5432
TOXIPROXY_REDIS_PROXY_NAME=redis
TOXIPROXY_REDIS_HOST=toxiproxy
TOXIPROXY_REDIS_PORT=16379
TOXIPROXY_REDIS_UPSTREAM=redis:6379

OTEL_SERVICE_NAME=darasa-core
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
