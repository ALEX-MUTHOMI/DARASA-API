# ─────────────────────────────────────────────────────────────────────────────
# Darasa API — Environment Variables Reference
#
# USAGE:
#   cp .env.example .env
#   Edit .env with your actual values
#
# SECURITY:
#   - NEVER commit .env to git (it is in .gitignore)
#   - In CI: these values are injected from GitHub Secrets
#   - In production: use your secrets manager (Doppler / AWS Secrets Manager)
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-50-char-random-string-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DB_HOST=db
DB_NAME=darasa_db
DB_USER=darasa_dev_user
DB_PASS=change-me-strong-db-password

# ── Redis (Celery Broker + Cache) ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=          # Uncomment and set in production



# ── Lemon Squeezy Billing ────────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
# Dual-secret rotation: promote secondary to primary when rotating
LEMON_SQUEEZY_WEBHOOK_SECRET_PRIMARY=your-primary-webhook-signing-secret
LEMON_SQUEEZY_WEBHOOK_SECRET_SECONDARY=your-retiring-webhook-signing-secret

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=Darasa <no-reply@darasa.app>

# ── Security ─────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
IP_HASH_SALT=a-unique-random-string-for-ip-hashing

# ── Logging / Observability ──────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
# SENTRY_DSN=             # Uncomment and set in production
# APP_VERSION=darasa-api@1.0.0
